---
/**
 * Base.astro — the single layout used by every page.
 *
 * Props:
 *   title       (string, required) — page title, WITHOUT the brand name (added automatically).
 *   description (string, required) — meta description.
 *   path        (string, required) — canonical path ("/", "/services"…).
 *   noindex     (bool, optional)   — adds <meta name="robots" content="noindex">.
 *   bodyClass   (string, optional)
 * Named slot "head": extra tags (page JSON-LD, third-party scripts).
 *
 * No unset value (isSet) is ever exposed: no canonical and no absolute Open
 * Graph URL while site.url is empty, no og:image without an image. Comments in
 * this file live in the frontmatter or in JSX comments — an HTML comment would
 * be published.
 */
import { site } from '../data/site';
import { ui } from '../data/content';
import { isSet, phoneHref } from '../lib/utils';
import { themeColor, accentColor } from '../lib/theme';
import { brandName } from '../lib/data';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/theme.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  bodyClass?: string;
}

const { title, description, path, noindex = false, bodyClass } = Astro.props;

const fullTitle = title.includes(brandName) ? title : `${title} — ${brandName}`;

const hasUrl = isSet(site.url);
const canonicalUrl = hasUrl ? new URL(path, site.url).href : '';
const ogImageUrl = hasUrl && isSet(site.seo.ogImage) ? new URL(site.seo.ogImage, site.url).href : '';

const initials = brandName
  .split(/[^A-Za-z0-9]+/)
  .filter(Boolean)
  .slice(0, 2)
  .map((w) => w[0].toUpperCase())
  .join('');

/* Favicon as a data URI, in the theme colours: the brand initials on a tile. */
const faviconSvg =
  `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64">` +
  `<rect width="64" height="64" rx="12" fill="${accentColor}"/>` +
  `<text x="32" y="33" font-family="Helvetica,Arial,sans-serif" font-size="30" font-weight="700" ` +
  `text-anchor="middle" dominant-baseline="central" fill="${themeColor}">${initials}</text></svg>`;
const faviconHref = `data:image/svg+xml,${encodeURIComponent(faviconSvg)}`;

/* "26 May 2023" -> "2023-05-26", for schema.org foundingDate. '' if unparseable. */
const MONTHS = ['january','february','march','april','may','june','july','august','september','october','november','december'];
function isoDate(text: string): string {
  const m = /^(\d{1,2})\s+([A-Za-z]+)\s+(\d{4})$/.exec(text.trim());
  if (!m) return '';
  const month = MONTHS.indexOf(m[2].toLowerCase());
  if (month < 0) return '';
  return `${m[3]}-${String(month + 1).padStart(2, '0')}-${m[1].padStart(2, '0')}`;
}

/*
 * Structured data for the company: ONLY values that are actually filled in.
 * While site.brand.name is empty, nothing is published (no fallback name).
 */
const c = site.company;
const sameAs = Object.values(site.social).filter((u) => isSet(u));
const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.brand.name,
};
if (isSet(c.legalName)) jsonLd.legalName = c.legalName;
if (isSet(site.brand.tagline)) jsonLd.description = site.brand.tagline;
if (hasUrl) {
  jsonLd['@id'] = `${site.url}/#organisation`;
  jsonLd.url = site.url;
}
if (ogImageUrl) jsonLd.image = ogImageUrl;
if (isSet(site.contact.email)) jsonLd.email = site.contact.email;
if (isSet(site.contact.phone)) jsonLd.telephone = phoneHref(site.contact.phone);
if (isSet(c.registeredOffice)) {
  jsonLd.address = { '@type': 'PostalAddress', streetAddress: c.registeredOffice, addressCountry: 'GB' };
}
if (isSet(c.number)) {
  jsonLd.identifier = {
    '@type': 'PropertyValue',
    name: 'Companies House company number',
    value: c.number,
  };
}
if (isSet(c.incorporated) && isoDate(c.incorporated)) jsonLd.foundingDate = isoDate(c.incorporated);
if (isSet(c.vatNumber)) jsonLd.vatID = c.vatNumber;
if (isSet(c.companiesHouseUrl)) sameAs.push(c.companiesHouseUrl);
if (sameAs.length > 0) jsonLd.sameAs = sameAs;

const keywords = site.seo.keywords.filter((k) => isSet(k)).join(', ');
---

<!doctype html>
<html lang={site.seo.lang} data-design={site.design}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {keywords && <meta name="keywords" content={keywords} />}
    {isSet(themeColor) && <meta name="theme-color" content={themeColor} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}

    <link rel="icon" href={faviconHref} type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={brandName} />
    <meta property="og:locale" content={site.seo.locale} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {
      ogImageUrl && (
        <Fragment>
          <meta property="og:image" content={ogImageUrl} />
          <meta property="og:image:width" content="1200" />
          <meta property="og:image:height" content="630" />
          <meta name="twitter:image" content={ogImageUrl} />
        </Fragment>
      )
    }
    <meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    {isSet(site.brand.name) && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    {/* Marks that JS is available before first paint (avoids a flash of hidden content). */}
    <script is:inline>document.documentElement.classList.add('js');</script>

    <slot name="head" />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#content">{ui.skipLink}</a>

    <Header />

    <main id="content" tabindex="-1">
      <slot />
    </main>

    <Footer />

    <script>
      // Gentle reveal on scroll, disabled when the visitor prefers reduced
      // motion or IntersectionObserver is unavailable.
      const targets = document.querySelectorAll<HTMLElement>('.reveal');
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (targets.length && (reducedMotion || !('IntersectionObserver' in window))) {
        targets.forEach((el) => el.classList.add('is-visible'));
      } else if (targets.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.12 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
